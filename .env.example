CTXTTL_HOST=127.0.0.1
CTXTTL_PORT=8765
CTXTTL_DATABASE_URL=sqlite:///./data/ctxttl.db
CTXTTL_UPSTREAM_BASE_URL=https://api.openai.com/v1
CTXTTL_UPSTREAM_API_KEY=
CTXTTL_UPSTREAM_TIMEOUT_SECONDS=60
CTXTTL_UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
CTXTTL_SESSION_HEADER=X-CtxTTL-Session-ID
CTXTTL_USER_HEADER=X-CtxTTL-User-ID
CTXTTL_TASK_HEADER=X-CtxTTL-Task-ID
CTXTTL_TURN_HEADER=X-CtxTTL-Turn-ID
CTXTTL_REQUEST_HEADER=X-CtxTTL-Request-ID
CTXTTL_MISSING_SESSION_BEHAVIOR=reject
CTXTTL_TARGET_CONTEXT_TOKENS=24000
CTXTTL_MAX_CONTEXT_TOKENS=64000
CTXTTL_RECENT_TURN_RESERVE=6
CTXTTL_TRACE_CAPTURE_CONTENT=false
CTXTTL_ARCHIVE_ENABLED=true
# Set empty only when indefinite raw-message retention is intentional.
CTXTTL_ARCHIVE_RETENTION_DAYS=30
CTXTTL_HISTORY_RETRIEVAL_ENABLED=true
CTXTTL_HISTORY_RETRIEVAL_LIMIT=2
CTXTTL_HISTORY_REFERENCE_RETRIEVAL_LIMIT=6
CTXTTL_RESPONSE_CAPTURE_MAX_BYTES=2000000
CTXTTL_LOG_LEVEL=INFO
