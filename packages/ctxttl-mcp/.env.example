CTXTTL_MCP_HOST=127.0.0.1
CTXTTL_MCP_PORT=8766
CTXTTL_MCP_PATH=/mcp
CTXTTL_MCP_CORE_URL=http://127.0.0.1:8765
# Optional credential for a protected Core or API gateway.
CTXTTL_MCP_CORE_BEARER_TOKEN=
# Set a long random value before exposing the MCP endpoint beyond a trusted local machine.
CTXTTL_MCP_BEARER_TOKEN=
CTXTTL_MCP_TIMEOUT_SECONDS=15
CTXTTL_MCP_MAX_REQUEST_BODY_BYTES=1048576
CTXTTL_MCP_LOG_LEVEL=INFO
